rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Regras do Cloud Storage — pasta "momentos/"
// Convidados podem enviar imagens e vídeos (com limite de tamanho),
// e qualquer pessoa com o link pode visualizar. Sem edição/remoção
// pelo cliente.
// ─────────────────────────────────────────────────────────────
service firebase.storage {
  match /b/{bucket}/o {

    match /momentos/{fileName} {

      // Qualquer pessoa pode ver as mídias (galeria pública via link).
      allow read: if true;

      // Envio: apenas imagem ou vídeo, com teto de 60 MB por arquivo.
      allow create: if
        request.resource.size < 60 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );

      // Sem sobrescrever ou apagar pelo cliente.
      allow update, delete: if false;
    }
  }
}
