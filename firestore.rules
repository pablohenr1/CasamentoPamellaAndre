rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Regras do Firestore — coleção "moments"
// O navegador NUNCA acessa o Firestore diretamente: toda leitura e
// escrita passa pelas functions serverless em /api (Firebase Admin
// SDK), que ignoram estas regras. Por isso aqui negamos tudo — é
// uma segunda camada de proteção, caso alguém tente falar direto
// com o Firestore usando as chaves públicas do projeto.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
