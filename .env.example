# ─────────────────────────────────────────────────────────────
# Firebase Admin SDK (server-only — o navegador nunca vê isso)
# ─────────────────────────────────────────────────────────────
# O navegador não fala mais direto com o Firestore: só as functions em
# /api (Firebase Admin SDK) acessam o banco. Por isso NENHUMA dessas
# variáveis tem prefixo VITE_ — se algum dia aparecer VITE_FIREBASE_*
# de novo, é sinal de que voltamos a expor isso no front-end.
#
# Onde achar: Console do Firebase > ⚙️ Configurações do projeto >
#   aba "Contas de serviço" > "Gerar nova chave privada" (baixa um .json).
#   No .json: project_id → FIREBASE_PROJECT_ID
#             client_email → FIREBASE_CLIENT_EMAIL
#             private_key → FIREBASE_PRIVATE_KEY (mantenha as \n literais)

FIREBASE_PROJECT_ID="seu-projeto"
FIREBASE_CLIENT_EMAIL="algo@seu-projeto.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ncole_a_chave_aqui\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 (guarda as fotos/vídeos)
# ─────────────────────────────────────────────────────────────
# SEM prefixo VITE_ de propósito: essas chaves são secretas e só devem
# existir no servidor (a function em /api/presign-upload.js). Nunca
# adicione VITE_ na frente delas.
# Onde achar: painel da Cloudflare > R2 > seu bucket > "Manage API Tokens".

R2_ACCOUNT_ID="seu-account-id"
R2_ACCESS_KEY_ID="cole_a_access_key_aqui"
R2_SECRET_ACCESS_KEY="cole_a_secret_key_aqui"
R2_BUCKET_NAME="seu-bucket"
# URL pública do bucket (r2.dev ou domínio customizado), SEM barra no final.
R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"

# ─────────────────────────────────────────────────────────────
# Segredo interno do servidor (não é de nenhum provedor externo)
# ─────────────────────────────────────────────────────────────
# Usado só pra assinar um "ticket" que prova que uma storagePath foi
# emitida pelo /api/presign-upload, antes do /api/moments aceitar criar
# ou cortar um momento com ela. Gere um valor aleatório único (ex:
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# — não reaproveite o mesmo valor entre projetos.
UPLOAD_TICKET_SECRET="gere_um_valor_aleatorio_unico_aqui"

# ─────────────────────────────────────────────────────────────
# Personalização do evento (aparecem na tela) — essas SIM levam VITE_,
# porque são só textos de exibição, sem nenhum valor sensível.
# ─────────────────────────────────────────────────────────────
VITE_NOIVOS="Pamella & André"
VITE_DATA_CASAMENTO="19 de setembro de 2026"

# Limite de duração dos vídeos, em segundos (troque para 15 se quiser vídeos menores)
VITE_VIDEO_MAX_SECONDS="30"

# Senha simples da área dos noivos (baixar tudo). Deixe em branco para não exigir senha.
# Obs: é uma trava leve no front-end, não uma proteção forte. Veja o README.
VITE_ADMIN_PIN="1909"
