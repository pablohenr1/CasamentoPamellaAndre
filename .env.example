# ─────────────────────────────────────────────────────────────
# Configuração do Firebase
# ─────────────────────────────────────────────────────────────
# Copie este arquivo para ".env" e preencha com os valores do SEU projeto Firebase.
#   Onde achar: Console do Firebase > ⚙️ Configurações do projeto >
#               aba "Geral" > seus apps > "Configuração do SDK" > "Config".
#
# IMPORTANTE:
# - Todas as variáveis precisam do prefixo VITE_ para o Vite expô-las ao navegador.
# - Essas chaves NÃO são segredo (elas ficam visíveis no front-end de qualquer app
#   Firebase). A segurança de verdade vem das Regras do Firestore/Storage — veja
#   os arquivos firestore.rules e storage.rules e o README.
# - No Vercel, cadastre as mesmas variáveis em: Project > Settings > Environment Variables.

VITE_FIREBASE_API_KEY="cole_sua_api_key_aqui"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────
# Personalização do evento (aparecem na tela)
# ─────────────────────────────────────────────────────────────
VITE_NOIVOS="Pamella & André"
VITE_DATA_CASAMENTO="19 de setembro de 2026"

# Limite de duração dos vídeos, em segundos (troque para 15 se quiser vídeos menores)
VITE_VIDEO_MAX_SECONDS="30"

# Senha simples da área dos noivos (baixar tudo). Deixe em branco para não exigir senha.
# Obs: é uma trava leve no front-end, não uma proteção forte. Veja o README.
VITE_ADMIN_PIN="1909"
